rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isAdmin();
      allow write: if false; // Manage admin documents manually in Firebase Console.
    }
    match /bank/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /keys/{id} {
      allow read, write: if isAdmin();
    }
    match /leaderboard/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /claims/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    match /results/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    match /live/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /progress/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.xp is number && request.resource.data.xp < 1000000;
      allow delete: if isAdmin();
    }
    match /data/users/{uid}/used {
      allow read, write: if signedIn() && request.auth.uid == uid || isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
